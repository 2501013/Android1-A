<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomAlertDialogTheme"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">

        <item name="android:background">#353535</item>
        <item name="colorSurface">#818181</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="colorAccent">#00C853</item>
        <item name="colorControlActivated">#00C853</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomDialogButtonStyle</item>

    </style>

    <style name="CustomDialogButtonStyle"
        parent="Widget.MaterialComponents.Button.TextButton.Dialog">

        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#6200EE</item>

    </style>

</resources>
